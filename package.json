{
  "name": "pokemon-openworld",
  "private": true,
  "version": "0.0.0",
  "description": "綠寶石畫面、朱／紫機制的寶可夢開放世界網頁遊戲（個人非營利）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "test": "playwright test --project=unit",
    "test:engine": "playwright test tests/e2e/engine.spec.js",
    "test:smoke": "playwright test tests/e2e/smoke.spec.js",
    "test:natural": "playwright test --project=natural",
    "test:install": "playwright install --with-deps chromium",
    "test:live": "node tools/live_check.mjs",
    "test:production": "playwright test --config playwright.production.config.js",
    "test:mobile": "playwright test tests/e2e/mobile.spec.js --project=unit",
    "test:perf": "node tools/perf_check.mjs",
    "test:ui": "node tools/ui_review.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "vite": "6.4.4"
  },
  "dependencies": {
    "preact": "10.24.3"
  }
}
